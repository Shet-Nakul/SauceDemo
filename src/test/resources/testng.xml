<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SauceDemo Test Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Login Tests" group-by-instances="true">
        <classes>
            <class name="com.saucedemo.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Inventory Tests" group-by-instances="true">
        <classes>
            <class name="com.saucedemo.tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Cart Tests" group-by-instances="true">
        <classes>
            <class name="com.saucedemo.tests.CartTest"/>
        </classes>
    </test>

    <test name="Checkout Tests" group-by-instances="true">
        <classes>
            <class name="com.saucedemo.tests.CheckoutTest"/>
        </classes>
    </test>

    <test name="End-to-End Tests" group-by-instances="true">
        <classes>
            <class name="com.saucedemo.tests.E2ETest"/>
        </classes>
    </test>

</suite>
